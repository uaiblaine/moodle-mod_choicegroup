{{!
    @template mod_choicegroup/report_downloads

    The download buttons of the responses report.

    Context variables required for this template:
    * buttons - one per format: button, the rendered single button (HTML)

    Example context (json):
    {
        "buttons": [
            {"button": "<button type=\"submit\" class=\"btn btn-secondary\">Download in ODS format</button>"},
            {"button": "<button type=\"submit\" class=\"btn btn-secondary\">Download in text format</button>"}
        ]
    }
}}
<div class="downloadreport">
    <ul>
        {{#buttons}}
            <li class="reportoption mt-1">{{{button}}}</li>
        {{/buttons}}
    </ul>
    <div class="clearfloat"></div>
</div>
